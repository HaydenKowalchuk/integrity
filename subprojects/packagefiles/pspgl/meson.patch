+ project('pspgl', 'c',
+   version : '1.0',
+   default_options : ['warning_level=3', 'c_std=gnu99'])
+ 
+ # PSP-specific configuration
+ cpp = meson.get_compiler('c')
+ psp_prefix = run_command('psp-config', '--psp-prefix', check: true).stdout().strip()
+ psp_sdk_path = run_command('psp-config', '--pspsdk-path', check: true).stdout().strip()
+ 
+ # Compiler and flags for PSP
+ add_project_arguments('-Wmissing-prototypes', '-G0', '-fsingle-precision-constant', language: 'c')
+ add_project_arguments('-I.', '-I' + psp_prefix + '/include', '-I' + psp_sdk_path + '/include', language: 'c')
+ 
+ # Link flags
+ add_project_link_arguments('-G0', '-L' + psp_prefix + '/lib', language: 'c')
+ 
+ # Source files for libGL
