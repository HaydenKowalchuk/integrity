+   'pspgl_varray_draw_elts.c',
+   'pspgl_varray_draw_range_elts.c',
+   'pspgl_vidmem.c'
+ ]
+ 
+ # libGL sources include the pregenerated header
+ gl_sources = api_sources + ['eglGetProcAddress.c']
+ 
+ # libGLU sources
+ glu_sources = [
+   'gluBuildMipmaps.c',
+   'gluLookAt.c',
+   'gluLookAtf.c',
+   'gluPerspective.c',
+   'gluPerspectivef.c',
+   'gluScaleImage.c',
+   'pspglu.c'
+ ]
+ 
+ # libglut sources
+ glut_sources = [
+   'glut.c',
+   'glut_shapes.c'
+ ]
+ 
+ # Build libraries
+ libgl = static_library('GL', gl_sources,
+   include_directories : include_directories('.'),
+   c_args : ['-I.', '-I' + psp_prefix + '/include', '-I' + psp_sdk_path + '/include'],
+   install : true,
+   install_dir : psp_prefix + '/lib'
+ )
+ 
+ libglu = static_library('GLU', glu_sources,
+   include_directories : include_directories('.'),
+   c_args : ['-I.', '-I' + psp_prefix + '/include', '-I' + psp_sdk_path + '/include'],
+   install : true,
+   install_dir : psp_prefix + '/lib'
+ )
+ 
+ libglut = static_library('glut', glut_sources,
+   include_directories : include_directories('.'),
+   c_args : ['-I.', '-I' + psp_prefix + '/include', '-I' + psp_sdk_path + '/include'],
+   install : true,
+   install_dir : psp_prefix + '/lib'
+ )
+ 
+ # Install headers
+ install_headers(
+   'GL/gl.h',
+   'GL/glext.h',
+   'GL/glu.h',
+   'GL/glut.h',
+   subdir : 'GL'
+ )
+ 
+ # Declare dependency for other projects
+ pspgl_dep = declare_dependency(
+   link_with : [libgl, libglu, libglut],
+   include_directories : include_directories('.')
+ )
+ 

